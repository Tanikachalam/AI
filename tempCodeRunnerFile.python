import tkinter as tk
from tkinter import filedialog

def select_file():
    root = tk.Tk()
    root.withdraw()  # Hide the main window
    file_path = filedialog.askopenfilename(
        title="Select a file",
        filetypes=[("All Files", "*.*")]
    )
    return file_path

if __name__ == "__main__":
    selected = select_file()
    print(f"Selected file: {selected}")